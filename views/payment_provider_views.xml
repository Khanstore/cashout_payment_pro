<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Provider Form View (extends base) ───────────────────────────────── -->
    <record id="payment_provider_form_cashout" model="ir.ui.view">
        <field name="name">payment.provider.form.cashout</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']" position="after">
                <page name="cashout_config" string="Cashout Settings"
                      invisible="[('code', '!=', 'cashout_pro')]">
                    <group>
                        <group string="Agent Configuration">
                            <field name="cashout_agent_number" required="1"
                                   help="Default agent number used by any payment method that doesn't set its own override. Configure individual methods (bKash, Nagad, Rocket, Upay, ...) under Cashout Pro → Configuration → Payment Methods."/>
                            <field name="cashout_secret_token"/>
                        </group>
                    </group>
                    <group string="Accounting">
                        <group>
                            <field name="journal_id"
                                   domain="[('type', 'in', ['bank','cash']), ('company_id', '=', company_id)]"
                                   help="Journal used to post customer payments when a cashout transaction is confirmed. Must have at least one Inbound Payment Method configured."/>
                        </group>
                    </group>
                    <group string="Checkout Page">
                        <field name="cashout_footer_note"/>
                        <div class="text-muted" colspan="2" style="font-size:0.85em;">
                            QR codes, agent numbers, and per-method instructions/steps are now
                            managed under <strong>Cashout Pro → Configuration → Payment Methods</strong>.
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ── Provider Action ─────────────────────────────────────────────────── -->
    <record id="action_cashout_provider" model="ir.actions.act_window">
        <field name="name">Cashout Provider</field>
        <field name="res_model">payment.provider</field>
        <field name="view_mode">form</field>
        <field name="domain">[('code', '=', 'cashout_pro')]</field>
        <field name="res_id" ref="payment_provider_cashout_pro"/>
    </record>
</odoo>