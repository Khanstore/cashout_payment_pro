<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ──────────────────────────────────────────────────────── -->
    <record id="payment_transaction_tree_cashout" model="ir.ui.view">
        <field name="name">payment.transaction.tree.cashout</field>
        <field name="model">payment.transaction</field>
        <field name="arch" type="xml">
            <list decoration-success="cashout_status == 'confirmed'"
                  decoration-warning="cashout_status == 'screenshot_uploaded'"
                  decoration-info="cashout_status == 'sms_matched'"
                  decoration-danger="cashout_status == 'rejected'"
                  decoration-muted="state == 'cancel'">
                <field name="create_date" string="Submitted"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="cashout_method" optional="show"/>
                <field name="cashout_txn_id" string="Txn ID" optional="show"/>
                <field name="cashout_sender" string="Sending No." optional="show"/>
                <field name="cashout_status" widget="badge"
                       decoration-success="cashout_status == 'confirmed'"
                       decoration-warning="cashout_status == 'screenshot_uploaded'"
                       decoration-info="cashout_status in ('sms_matched', 'waiting')"
                       decoration-danger="cashout_status == 'rejected'"/>
                <field name="state" optional="show"/>
                <button name="action_cashout_confirm" type="object"
                        string="✅ Confirm" class="btn-sm btn-success"
                        />
                <button name="action_cashout_reject" type="object"
                        string="❌ Reject" class="btn-sm btn-danger"
                        />
            </list>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────────── -->
    <record id="payment_transaction_search_cashout" model="ir.ui.view">
        <field name="name">payment.transaction.search.cashout</field>
        <field name="model">payment.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="cashout_txn_id" string="Transaction ID"/>
                <field name="cashout_sender" string="Sending Number"/>
                <separator/>
                <filter string="⏳ Pending Review" name="pending_review"
                        domain="[('cashout_status', '=', 'screenshot_uploaded')]"/>
                <filter string="⌛ Waiting" name="waiting"
                        domain="[('cashout_status', '=', 'waiting')]"/>
                <filter string="📡 SMS Matched" name="sms_matched"
                        domain="[('cashout_status', '=', 'sms_matched')]"/>
                <filter string="✅ Confirmed" name="confirmed"
                        domain="[('cashout_status', '=', 'confirmed')]"/>
                <filter string="❌ Rejected" name="rejected"
                        domain="[('cashout_status', '=', 'rejected')]"/>
                <separator/>
                <filter string="bKash" name="bkash"
                        domain="[('cashout_method', '=', 'bkash')]"/>
                <filter string="Nagad" name="nagad"
                        domain="[('cashout_method', '=', 'nagad')]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'cashout_status'}"/>
                    <filter name="group_method" string="Method"
                            context="{'group_by': 'cashout_method'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────────────── -->
    <!--
        priority="1" makes Odoo prefer this view over the default payment form
        (default priority is 16). Confirm/Reject buttons and cashout fields
        carry invisible="provider_code != 'cashout_pro'" so they stay hidden
        for all other payment providers.
    -->
    <record id="payment_transaction_form_cashout" model="ir.ui.view">
        <field name="name">payment.transaction.form.cashout</field>
        <field name="model">payment.transaction</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cashout_confirm" type="object"
                            string="✅ Confirm Payment"
                            class="btn-success"
                            invisible="['|',
                                ('provider_code', '!=', 'cashout_pro'),
                                ('cashout_status', 'in', ['confirmed', 'rejected'])
                            ]"/>
                    <button name="action_cashout_reject" type="object"
                            string="❌ Reject"
                            class="btn-danger"
                            invisible="['|',
                                ('provider_code', '!=', 'cashout_pro'),
                                ('cashout_status', 'in', ['confirmed', 'rejected'])
                            ]"/>
                    <button name="action_view_screenshot" type="object"
                            string="🖼 View Screenshot"
                            class="btn-secondary"
                            invisible="['|',
                                ('provider_code', '!=', 'cashout_pro'),
                                ('cashout_screenshot', '=', False)
                            ]"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,authorized,done,cancel"/>
                </header>
                <sheet>
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3"
                         role="alert"
                         invisible="[('cashout_status', '!=', 'screenshot_uploaded')]">
                        <span style="font-size:1.4rem;">⏳</span>
                        <div>
                            <strong>Proof Uploaded — Action Required</strong><br/>
                            Customer has submitted their screenshot.
                            Please review and <strong>Confirm</strong> or <strong>Reject</strong>.
                        </div>
                    </div>
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-3"
                         role="alert"
                         invisible="[('cashout_status', '!=', 'sms_matched')]">
                        <span style="font-size:1.4rem;">📡</span>
                        <div>
                            <strong>SMS Auto-Matched</strong> — Transaction was verified via SMS relay.
                            Click <strong>Confirm Payment</strong> to finalise the order.
                        </div>
                    </div>
                    <div class="alert alert-success d-flex align-items-center gap-2 mb-3"
                         role="alert"
                         invisible="[('cashout_status', '!=', 'confirmed')]">
                        <span style="font-size:1.4rem;">✅</span>
                        <div><strong>Payment Confirmed</strong> — Order has been updated.</div>
                    </div>
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3"
                         role="alert"
                         invisible="[('cashout_status', '!=', 'rejected')]">
                        <span style="font-size:1.4rem;">❌</span>
                        <div><strong>Payment Rejected</strong> — Transaction cancelled.</div>
                    </div>

                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Payment Info">
                            <field name="partner_id"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id"/>
                            <field name="provider_id"/>
                            <field name="create_date" string="Submitted On"/>
                        </group>
                        <group string="Cashout Details"
                               invisible="[('provider_code', '!=', 'cashout_pro')]">
                            <field name="cashout_method"/>
                            <field name="cashout_status" widget="badge"
                                   decoration-success="cashout_status == 'confirmed'"
                                   decoration-warning="cashout_status == 'screenshot_uploaded'"
                                   decoration-info="cashout_status in ('sms_matched','waiting')"
                                   decoration-danger="cashout_status == 'rejected'"/>
                            <field name="cashout_txn_id" string="Transaction ID"/>
                            <field name="cashout_sender" string="Sending Number"/>
                            <field name="cashout_verified" widget="boolean_toggle"/>
                            <field name="cashout_verified_by" readonly="1"/>
                            <field name="cashout_confirmed_date" readonly="1"
                                   invisible="[('cashout_confirmed_date', '=', False)]"/>
                            <field name="sms_log_id"
                                   invisible="[('sms_log_id', '=', False)]"/>
                        </group>
                    </group>

                    <notebook invisible="[('provider_code', '!=', 'cashout_pro')]">
                        <page string="📸 Payment Screenshot" name="screenshot">
                            <div invisible="[('cashout_screenshot', '!=', False)]"
                                 class="text-muted p-3">
                                No screenshot uploaded yet.
                            </div>
                            <div invisible="[('cashout_screenshot', '=', False)]">
                                <field name="cashout_screenshot" widget="image"
                                       options='{"size": [700, 500]}'
                                       nolabel="1"/>
                                <div class="mt-2">
                                    <field name="cashout_screenshot_name" readonly="1"
                                           string="Filename"/>
                                </div>
                            </div>
                        </page>
                        <page string="💬 Customer Note" name="note">
                            <field name="cashout_customer_note" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Window Action ──────────────────────────────────────────────────── -->
    <record id="action_cashout_transactions" model="ir.actions.act_window">
        <field name="name">Cashout Transactions</field>
        <field name="res_model">payment.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('provider_code', '=', 'cashout_pro')]</field>
        <field name="context">{"search_default_pending_review": 1}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('payment_transaction_tree_cashout')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('payment_transaction_form_cashout')}),
        ]"/>
        <field name="search_view_id" ref="payment_transaction_search_cashout"/>
    </record>

</odoo>
