<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_cashout_confirmed" model="mail.template">
        <field name="name">Cashout Payment: Order Confirmed</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="subject">✅ Payment Confirmed — Order {{ object.reference }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:560px;margin:0 auto;color:#1a1a2e;">
  <div style="background:linear-gradient(135deg,#1a1a2e,#0f3460);padding:28px 32px;border-radius:12px 12px 0 0;text-align:center;">
    <h1 style="color:#fff;font-size:1.5rem;margin:0;">&#9989; Payment Confirmed!</h1>
    <p style="color:rgba(255,255,255,.75);margin:.5rem 0 0;font-size:.95rem;">Your order has been successfully verified</p>
  </div>
  <div style="background:#f7f8fc;padding:32px;border:1px solid #e3e6f0;border-radius:0 0 12px 12px;">
    <p style="margin-top:0;">Dear <strong>{{ object.partner_id.name or 'Customer' }}</strong>,</p>
    <p>Great news! Your cashout payment has been verified by our team and your order is now confirmed.</p>

    <table style="width:100%;border-collapse:collapse;background:#fff;border-radius:8px;overflow:hidden;border:1px solid #e3e6f0;margin:1.25rem 0;">
      <tr style="background:#f0f4ff;">
        <td style="padding:11px 16px;font-weight:600;color:#666;font-size:.85rem;border-bottom:1px solid #e3e6f0;">Order Reference</td>
        <td style="padding:11px 16px;font-weight:700;border-bottom:1px solid #e3e6f0;">{{ object.reference }}</td>
      </tr>
      <tr>
        <td style="padding:11px 16px;font-weight:600;color:#666;font-size:.85rem;border-bottom:1px solid #e3e6f0;">Amount Paid</td>
        <td style="padding:11px 16px;font-weight:700;border-bottom:1px solid #e3e6f0;">
          {{ '%.2f' % object.amount }} {{ object.currency_id.symbol }}
        </td>
      </tr>
      <tr style="background:#f0f4ff;">
        <td style="padding:11px 16px;font-weight:600;color:#666;font-size:.85rem;border-bottom:1px solid #e3e6f0;">Payment Method</td>
        <td style="padding:11px 16px;font-weight:700;border-bottom:1px solid #e3e6f0;">
          {% if object.cashout_method == 'bkash' %}bKash{% else %}Nagad{% endif %}
        </td>
      </tr>
      <tr>
        <td style="padding:11px 16px;font-weight:600;color:#666;font-size:.85rem;">Transaction ID</td>
        <td style="padding:11px 16px;font-weight:700;">{{ object.cashout_txn_id or '—' }}</td>
      </tr>
    </table>

    <p style="margin-bottom:0;color:#666;font-size:.875rem;">
      If you have any questions about your order, please contact our support team.<br/>
      Thank you for your purchase!
    </p>
  </div>
</div>
        ]]></field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
