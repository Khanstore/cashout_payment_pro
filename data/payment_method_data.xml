<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ══ noupdate="1" — only written on FRESH install, so admin edits/additions
         (like adding Rocket or Upay) survive future module upgrades ══════ -->
    <data noupdate="1">

        <record id="cashout_method_bkash" model="cashout.payment.method">
            <field name="name">bKash</field>
            <field name="code">bkash</field>
            <field name="sequence">10</field>
            <field name="color">#E2136E</field>
            <field name="provider_id" ref="cashout_payment_pro.payment_provider_cashout_pro"/>
            <field name="instructions">Open bKash app → Cashout → Scan QR or type agent number → Enter exact amount → Confirm with PIN → Note the Transaction ID from your SMS.</field>
        </record>

        <record id="cashout_method_nagad" model="cashout.payment.method">
            <field name="name">Nagad</field>
            <field name="code">nagad</field>
            <field name="sequence">20</field>
            <field name="color">#F5A623</field>
            <field name="provider_id" ref="cashout_payment_pro.payment_provider_cashout_pro"/>
            <field name="instructions">Open Nagad app → Cash Out → Scan QR or type agent number → Enter exact amount → Confirm with PIN → Note the Transaction ID from your SMS.</field>
        </record>

    </data>
</odoo>
