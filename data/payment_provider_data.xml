<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Created once. The upgrade block below is intentionally separate so
         existing installations always receive the current image and method link. -->
    <data noupdate="1">
        <record id="payment_method_cashout_pro" model="payment.method">
            <field name="name">Cashout</field>
            <field name="code">cashout_pro</field>
            <field name="sequence">10</field>
            <field name="active">True</field>
            <!-- Odoo 18 payment.method image field. image_payment_form is
                 generated automatically from this field. -->
            <field name="image" type="base64" file="cashout_payment_pro/static/description/iconBK.png"/>
        </record>

        <record id="payment_provider_cashout_pro" model="payment.provider">
            <field name="name">Cashout Pro</field>
            <field name="code">cashout_pro</field>
            <field name="state">enabled</field>
            <field name="is_published">True</field>
            <field name="image_128" type="base64" file="cashout_payment_pro/static/description/iconBK.png"/>
            <field name="cashout_agent_number">01970569256</field>
            <field name="cashout_secret_token">CASHOUT_ASHRAF_SECRET_2024</field>
            <field name="cashout_footer_note">After cashout, upload your transaction screenshot as payment proof. Your order will be confirmed within a few minutes.</field>
            <field name="pending_msg" type="html"><p>Your cashout payment is being processed. Please complete your cashout using the selected payment method to the agent number and upload your screenshot.</p></field>
            <field name="done_msg" type="html"><p>&#9989; Your payment has been verified. Thank you!</p></field>
            <field name="cancel_msg" type="html"><p>Your payment has been cancelled.</p></field>
        </record>


    </data>

    <!-- Re-applied on every module upgrade. This also repairs installations
         created by earlier versions where image_128 was incorrectly used on
         payment.method. -->
    <data noupdate="0">
        <record id="payment_method_cashout_pro" model="payment.method">
            <field name="name">Cashout</field>
            <field name="image" type="base64" file="cashout_payment_pro/static/description/iconBK.png"/>
        </record>
        <record id="payment_provider_cashout_pro" model="payment.provider">
            <field name="name">Cashout Pro</field>
            <field name="image_128" type="base64" file="cashout_payment_pro/static/description/iconBK.png"/>
            <field name="payment_method_ids" eval="[(4, ref('cashout_payment_pro.payment_method_cashout_pro'))]"/>
            <field name="redirect_form_view_id" ref="cashout_payment_pro.cashout_pro_redirect_form"/>
        </record>


    </data>
</odoo>
